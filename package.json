{
  "name": "studiostack",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "tsx scripts/prepare-photo-codecs.ts",
    "dev": "next dev --hostname 0.0.0.0 --port 5174",
    "build": "next build",
    "prebuild": "tsx scripts/clean-static-output.ts && tsx scripts/prepare-photo-codecs.ts",
    "start": "next start --hostname 0.0.0.0 --port 5174",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run src/integration",
    "test:ui": "vitest --ui",
    "typecheck:aws": "tsc --project tsconfig.aws.json",
    "aws:check": "node --env-file-if-exists=.env.local --import=tsx scripts/check-s3.ts",
    "aws:cors:dev": "node --env-file-if-exists=.env.local --import=tsx scripts/configure-s3-cors.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "db:deploy": "node --import=tsx scripts/deploy-database.ts",
    "db:check:dev": "node --env-file-if-exists=.env.local --env-file=.env.rds.dev.local --import=tsx scripts/check-database.ts",
    "db:check:prod": "node --env-file-if-exists=.env.local --env-file=.env.rds.prod.local --import=tsx scripts/check-database.ts",
    "db:migrate:dev": "node --env-file-if-exists=.env.local --env-file=.env.rds.dev.local --import=tsx scripts/migrate-database.ts",
    "db:migrate:prod": "node --env-file-if-exists=.env.local --env-file=.env.rds.prod.local --import=tsx scripts/migrate-database.ts",
    "test:database": "vitest run src/api/database.backend.test.ts src/api/database.infrastructure.test.ts src/api/database.api.test.ts src/api/database.client.test.ts",
    "db:api:prepare": "node --import=tsx scripts/prepare-database-api.ts",
    "test:database:postgres": "node --import=tsx scripts/test-database-api-postgres.ts",
    "production:deploy:dev": "node --import=tsx scripts/deploy-dev-api.ts --apply-dev",
    "production:web:dev": "node --import=tsx scripts/deploy-production-web.ts --apply-dev",
    "production:notifications:dev": "node --import=tsx scripts/deploy-production-notifications.ts --apply-dev",
    "postbuild": "tsx scripts/prepare-static-routes.ts"
  },
  "dependencies": {
    "@aws-amplify/auth": "^6.21.2",
    "@aws-amplify/core": "^6.19.3",
    "@aws-sdk/client-cognito-identity-provider": "^3.1158.0",
    "@aws-sdk/client-lambda": "^3.1158.0",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/client-secrets-manager": "^3.1150.0",
    "@aws-sdk/client-sesv2": "^3.1158.0",
    "@aws-sdk/s3-presigned-post": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "3.1147.0",
    "@fullcalendar/daygrid": "^6.1.15",
    "@fullcalendar/interaction": "^6.1.15",
    "@fullcalendar/react": "^6.1.15",
    "@fullcalendar/timegrid": "^6.1.15",
    "@jsquash/avif": "^2.1.1",
    "@tailwindcss/postcss": "^4.0.3",
    "html5-qrcode": "^2.3.8",
    "image-size": "^2.0.4",
    "libheif-js": "^1.23.5",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.4.0",
    "react-qr-code": "^2.0.18",
    "react-select": "^5.10.0",
    "reactjs-popup": "^2.0.6",
    "sharp": "0.35.5",
    "tailwindcss": "^4.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "happy-dom": "^21.0.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.0.18"
  }
}
