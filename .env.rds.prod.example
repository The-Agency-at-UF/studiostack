STUDIOSTACK_ENV=prod
AWS_REGION=us-east-2
RDS_AWS_ACCOUNT_ID=111122223333
RDS_HOST=studiostack-prod-db.cluster-REPLACE.us-east-2.rds.amazonaws.com
RDS_PORT=5432
RDS_DATABASE=studiostackprod
# Master secret for operator check/migrations only; restricted app secret at runtime.
RDS_SECRET_ARN=arn:aws:secretsmanager:us-east-2:111122223333:secret:REPLACE
# After the move to RDS for PostgreSQL: RDS_HOST=studiostack-prod-pg.REPLACE.us-east-2.rds.amazonaws.com
# IAM login instead of a secret: RDS_AUTH=iam and RDS_IAM_USER=studiostack_prod_app (omit RDS_SECRET_ARN).
RDS_CA_BUNDLE_PATH=./.aws/us-east-2-bundle.pem
RDS_CONNECT_TIMEOUT_MS=45000
