# Backend/operator tooling only. Never use NEXT_PUBLIC_ for database settings.
STUDIOSTACK_ENV=dev
AWS_REGION=us-east-2
RDS_AWS_ACCOUNT_ID=111122223333
RDS_HOST=studiostack-dev-db.cluster-REPLACE.us-east-2.rds.amazonaws.com
RDS_PORT=5432
RDS_DATABASE=studiostackdev
# Use the master secret ONLY for db:check / explicitly applied migrations.
# Normal backend requests must use a separate restricted application-user secret.
RDS_SECRET_ARN=arn:aws:secretsmanager:us-east-2:111122223333:secret:REPLACE
RDS_CA_BUNDLE_PATH=./.aws/us-east-2-bundle.pem
RDS_CONNECT_TIMEOUT_MS=45000
