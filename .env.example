# Backend/local tooling only. Credentials come from SSO locally and IAM in Lambda.
AWS_PROFILE=studiostack-dev
AWS_REGION=us-east-2
S3_PHOTOS_BUCKET=studio-stack-photos-dev

# Public browser OAuth configuration — never put secrets in NEXT_PUBLIC_ values.
# Existing dev defaults apply only at http://localhost:5174.
# For a hosted website, configure these and register its callback/logout URLs
# on the corresponding Cognito app client. Do not point a prod site at dev.
# NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-2_yourPoolId
# NEXT_PUBLIC_COGNITO_DOMAIN=https://your-domain.auth.us-east-2.amazoncognito.com
# NEXT_PUBLIC_COGNITO_APP_CLIENT_ID=yourPublicClientId
# NEXT_PUBLIC_COGNITO_REDIRECT_URI=https://your-website.example/login/
# NEXT_PUBLIC_DATABASE_API_URL=https://your-api.execute-api.us-east-2.amazonaws.com

# Activate only AFTER these providers exist in Cognito AND are enabled on
# the public app client. Leave unset to display honest "Coming soon" buttons.
# Provider secrets/private keys belong in Cognito configuration, NOT here.
# NEXT_PUBLIC_COGNITO_ENABLED_PROVIDERS=Google,SignInWithApple,UF
# Exact name of the institution's SAML IdP in the same user pool:
# NEXT_PUBLIC_COGNITO_SAML_PROVIDER=UF
